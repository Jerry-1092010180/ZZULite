<view class="page"><text class="eyebrow">CAMPUS LIFE</text><view class="title">校园服务</view>
<view wx:if="{{!logged}}" class="card row"><view class="heading">请先连接学校账号</view><text class="link" bindtap="login">登录 ›</text></view>
<view class="card"><view class="row"><text class="heading">校园卡余额</text><text class="badge">只读查询</text></view><view class="amount">{{balance === '' ? '—' : '¥ ' + balance}}</view><view class="small">{{updated ? '查询于 ' + updated : '点击下方按钮读取学校余额'}}</view><button class="primary" bindtap="balance" loading="{{loadingBalance}}" disabled="{{loadingBalance}}">{{balance === '' ? '查询余额' : '刷新余额'}}</button><view wx:if="{{balanceError}}" class="error">{{balanceError}}</view></view>
<view class="card row" bindtap="electricity"><view><view class="heading">宿舍电量</view><view class="small">照明与空调分别查询</view></view><text class="link">进入 ›</text></view><view class="card"><view class="heading">教室占用</view><view class="small">按楼栋和日期查看学校登记的占用时段</view><button class="secondary" bindtap="loadCampuses" disabled="{{loading}}">{{campuses.length ? '重新加载校区' : '加载校区与楼栋'}}</button>
<view wx:if="{{campuses.length}}"><picker range="{{campuses}}" range-key="nameZh" value="{{campusIndex}}" bindchange="changeCampus" disabled="{{loading}}"><view class="select row"><text>校区</text><text class="link">{{campuses[campusIndex].nameZh}} ⌄</text></view></picker><picker wx:if="{{buildings.length}}" range="{{buildings}}" range-key="nameZh" value="{{buildingIndex}}" bindchange="changeBuilding" disabled="{{loading}}"><view class="select row"><text>楼栋</text><text class="link">{{buildings[buildingIndex].nameZh}} ⌄</text></view></picker><view wx:else class="small">该校区暂无可选楼栋</view><picker mode="date" value="{{date}}" bindchange="changeDate" disabled="{{loading}}"><view class="select row"><text>日期</text><text class="link">{{date}} ⌄</text></view></picker><button class="primary" bindtap="query" disabled="{{loading || !buildings.length}}" loading="{{loading}}">查询教室</button></view><view wx:if="{{error}}" class="error">{{error}}</view></view>
<view wx:if="{{queried && !rooms.length}}" class="empty">该条件下没有教室记录</view>
<view wx:for="{{rooms}}" wx:key="id" class="card"><view class="row"><text class="heading">{{item.name}}</text></view><view wx:if="{{!item.periods.length}}" class="small">学校未返回当天占用记录</view><view wx:for="{{item.periods}}" wx:for-item="period" wx:key="index" class="occupancy row"><text>{{period.time}}</text><text class="badge">{{period.type}}</text></view></view>
<button wx:if="{{more}}" class="secondary" bindtap="next" loading="{{loading}}" disabled="{{loading}}">加载更多教室</button><view class="small">无占用记录不代表一定开放，开放安排以学校通知为准。<view class="divider"/>电量查询与读数记录可从「宿舍电量」进入。</view></view>
