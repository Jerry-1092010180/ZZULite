.search{background:#f2f2f7;border-radius:16rpx;padding:22rpx;margin:24rpx 0;font-size:27rpx}.course{flex:1;min-width:0}.score{font-size:42rpx;font-weight:600;color:#007aff;max-width:200rpx;word-break:break-all}

