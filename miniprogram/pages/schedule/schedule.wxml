<view class="page"><text class="eyebrow">YOUR WEEK</text><view class="row"><view class="title">课表</view><text class="link" bindtap="refresh">{{busy?'同步中…':'同步课表'}}</text></view>
<view wx:if="{{!logged}}" class="card row"><view><view class="heading">连接学校账号</view><view class="small">{{hasCache?'离线课表仍可查看':'同步整学期课程与实验排课'}}</view></view><text class="link" bindtap="login">登录 ›</text></view>
<view wx:if="{{error}}" class="error">{{error}}</view>
<view wx:if="{{hasCache}}"><picker range="{{semesters}}" range-key="nameZh" value="{{semesterIndex}}" bindchange="changeSemester" disabled="{{busy}}"><view class="row"><text class="heading">{{name}}</text><text class="link">切换学期⌄</text></view></picker><view class="card row"><text class="link" bindtap="previous">‹ 上周</text><view bindtap="current"><view class="heading">第 {{week}} 周</view><view class="small">点击回到当前周</view></view><text class="link" bindtap="next">下周 ›</text></view>
<view wx:for="{{groups}}" wx:key="day" class="day"><view class="row"><text class="heading">{{item.day}}</text><text class="small">{{item.items.length}} 项安排</text></view><view wx:if="{{!item.items.length}}" class="free">暂无课程安排</view><view class="lesson" wx:for="{{item.items}}" wx:for-item="lesson" wx:key="id"><view class="lesson-mark">{{lesson.start > 0 ? lesson.start + '–' + lesson.end : '待定'}}<view class="small">{{lesson.start > 0 ? '节' : '节次'}}</view></view><view class="lesson-body"><view class="row"><text class="heading">{{lesson.name}}</text><text wx:if="{{lesson.experiment}}" class="badge">实验</text></view><view class="course-time">{{lesson.time}}</view><view class="small">{{lesson.place}}</view><view wx:if="{{lesson.date}}" class="small">{{lesson.date}}</view></view></view></view><view class="small">最近同步 {{updated}} · 数据保存在本机</view></view>
<view wx:else class="empty">把一整周，安排得清清楚楚。<view class="small">登录后点击右上角「同步课表」</view></view></view>