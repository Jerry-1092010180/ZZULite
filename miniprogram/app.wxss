page{background:#f2f2f7;color:#202128;font-family:-apple-system,BlinkMacSystemFont,sans-serif}.page{padding:36rpx 32rpx 64rpx}.eyebrow{font-size:22rpx;letter-spacing:3rpx;color:#8e8e93;font-weight:600}.title{font-size:60rpx;font-weight:700;letter-spacing:-2rpx;margin:12rpx 0 28rpx}.subtitle{color:#8e8e93;font-size:26rpx;line-height:1.7}.card{background:#fff;border-radius:28rpx;padding:28rpx;margin:24rpx 0}.row{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap}.heading{font-size:32rpx;font-weight:600}.small{font-size:24rpx;color:#8e8e93;line-height:1.7}.primary{background:#007aff;color:white;border-radius:22rpx;font-size:28rpx;font-weight:600;margin:28rpx 0 12rpx}.secondary{background:#fff;color:#007aff;border-radius:22rpx;font-size:27rpx;margin:20rpx 0}.error{background:#fff0ed;color:#a33f30;padding:24rpx;font-size:26rpx;line-height:1.6;border-radius:22rpx;margin:20rpx 0}.empty{text-align:center;padding:70rpx 30rpx;color:#8e8e93;font-size:28rpx;line-height:1.8}.link{color:#007aff;font-size:26rpx}.badge{background:#eaf3ff;color:#007aff;border-radius:10rpx;font-size:22rpx;padding:4rpx 12rpx}.field{background:#fff;border-radius:18rpx;padding:26rpx;margin:18rpx 0;font-size:30rpx}button::after{border:0}.divider{height:1rpx;background:#f2f2f7;margin:24rpx 0}
.page{box-sizing:border-box;width:100%;max-width:900px;margin:0 auto;padding-bottom:64rpx;padding-bottom:calc(64rpx + constant(safe-area-inset-bottom));padding-bottom:calc(64rpx + env(safe-area-inset-bottom))}
.row>view,.row>text{min-width:0}.heading{word-break:break-word;overflow-wrap:break-word;line-height:1.5}.link{display:inline-block;min-height:44px;line-height:44px;padding:0 6rpx;flex-shrink:0}.row>.link{margin-left:16rpx}.field,.search{min-height:44px;box-sizing:content-box}.course-time{font-size:29rpx;font-weight:600;color:#007aff;margin:10rpx 0;line-height:1.6;white-space:nowrap}button{min-height:44px}.title{line-height:1.35}.small{word-break:break-word}
@media (max-width:360px){.page{padding-left:24rpx;padding-right:24rpx}.title{font-size:52rpx}.card{padding:24rpx}.heading{font-size:29rpx}}
